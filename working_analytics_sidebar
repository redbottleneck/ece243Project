    int y1 = prev_array[j + 1];
    draw_line(x0, y0, x1, y1, 0x18e5);
}

//clear screen
volatile int * pixel_ctrl_ptr = (int *)0xFF203020;
pixel_buffer_start = *pixel_ctrl_ptr;
clear_screen();

// Calculate and display y-axis labels
calculate_y_divisions();
calculate_x_divisions(global_date, count,arr);

// Use a float to avoid integer truncation:
float xscale = (float)(GRAPH_WIDTH - 1) / (float)(count - 1);

 int x_line = GRAPH_WIDTH_PADDING + (int)(x_global * xscale);
 draw_line(prev_x_line,  240-GRAPH_HEIGHT_PADDING-GRAPH_HEIGHT, prev_x_line, 240-GRAPH_HEIGHT_PADDING+1, 0x18e5); 
	
 draw_line(x_line, normalized[x_global], x_line, 240-GRAPH_HEIGHT_PADDING+1, 0xFF0F); 
for (int j = 0; j < count - 1; j++) {
    // Scale the j-th sample from [0 .. count-1] into [0 .. GRAPH_WIDTH-1]
    int x0 = GRAPH_WIDTH_PADDING + (int)(j * xscale);
    int x1 = GRAPH_WIDTH_PADDING + (int)((j + 1) * xscale);

    int y0 = normalized[j];
    int y1 = normalized[j + 1];
    draw_line(x0, y0, x1, y1, s->color);
}

prev_count = count;
for (int i = 0; i < count; i++) {
prev_array[i] = normalized[i];
}
prev_scale = xscale;
prev_x_line = x_line;

}

