//---------------------------------------------------------------------
// Stock structure: holds two arrays (dates and values) plus a name.
// We also include a parsed_dates array for easier date filtering.
//---------------------------------------------------------------------
typedef struct {
    const char **dates;   // Array of date strings (e.g., "1/2/2015")
    float *values;        // Array of stock values
    char *name;           // Stock name
    int size;             // Number of data points
    short int color;
    time_t *parsed_dates; // Array of parsed dates (computed from dates)
} Stock;

typedef struct {
    volatile unsigned char data;
    volatile unsigned char rvalid;
    volatile unsigned short ravail;
    volatile unsigned char re;
    volatile unsigned char rice;
} Mouse;

struct audio_t {
	volatile unsigned int control;
	volatile unsigned char rarc;
	volatile unsigned char ralc;
	volatile unsigned char warc;
	volatile unsigned char walc;
    volatile unsigned int ldata;
	volatile unsigned int rdata;
};


